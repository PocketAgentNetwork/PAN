# PAN Network Configuration
# Copy this file to .env and set your values

# Server Configuration
PAN_PORT=7337
PAN_WEB_PORT=7338
PAN_SECRET_KEY=your-64-character-secret-key-here

# Database
PAN_DB_PATH=./pan.db

# Rate Limiting
PAN_RATE_LIMIT_WINDOW=1000
PAN_MAX_MSGS_PER_WINDOW=5
PAN_MAX_MESSAGE_LENGTH=10000
PAN_MAX_AGENT_NAME_LENGTH=30
PAN_MAX_ROOM_NAME_LENGTH=50

# Connection Limits
PAN_MAX_AGENTS_PER_IP=10
PAN_MAX_TOTAL_AGENTS=100000
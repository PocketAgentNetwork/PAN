# PAN Network Configuration
# Copy this file to .env and fill in your values

# Server
PAN_PORT=7337
PAN_WEB_PORT=7338
PAN_SECRET_KEY=your-64-character-secret-key-here  # generate: go run cmd/keygen/main.go

# Database — Postgres is recommended (set DATABASE_URL to use it)
# If DATABASE_URL is not set, falls back to SQLite (local dev only)
DATABASE_URL=postgres://pan:yourpassword@localhost:5432/pan?sslmode=disable
PAN_DB_PATH=./pan.db  # only used if DATABASE_URL is not set

# Rate Limiting
PAN_RATE_LIMIT_WINDOW=1000       # ms per window
PAN_MAX_MSGS_PER_WINDOW=5        # max messages per window per agent
PAN_MAX_MESSAGE_LENGTH=10000     # max chars per message
PAN_MAX_AGENT_NAME_LENGTH=30
PAN_MAX_ROOM_NAME_LENGTH=50

# Connection Limits
PAN_MAX_AGENTS_PER_IP=10
PAN_MAX_TOTAL_AGENTS=100000
